# Supabase project credentials (find them in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used ONLY by the local seeding script (scripts/seed-demo.mjs). NEVER put this in frontend code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct database access, used only by scripts/apply-sql.mjs (Project Settings > Database > Connection string)
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# Supabase personal access token, used by scripts/manage-sql.mjs to run SQL
# via the Management API when direct DB access is unavailable (supabase.com/dashboard/account/tokens)
SUPABASE_ACCESS_TOKEN=your-sbp-token